# Conductor Again — Environment Variables
# Copy to .env and fill in values

# Required
JWT_SECRET_KEY=change-me-to-a-random-32-char-string

# Deployment
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
COOKIE_SECURE=false

# Data
DATA_DIR=./data

# Bootstrap Admin
ADMIN_EMAIL=admin@conductoragain.local
ADMIN_PASSWORD=ChangeMe123!

# Cloudflare R2 (optional in dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=conductor-again-dev
R2_ENDPOINT=
R2_PRESIGN_TTL_SECONDS=300
R2_MAX_UPLOAD_BYTES=52428800

# Cloudflare Turnstile (optional in dev)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# E8-C: Account Again (ecosystem identity/entitlement/credential authority)
ACCOUNT_AGAIN_URL=http://localhost:8001/api/v1
ACCOUNT_AGAIN_SYSTEM_ID=CONDUCTOR_MAIN
ACCOUNT_AGAIN_CLIENT_SECRET=
# ECOSYSTEM_MODE=true makes Account Again authoritative for identity/tenant/entitlement
# and demotes local auth to LEGACY_LOCAL_AUTH (dev-only, non-authoritative). false keeps
# pre-E8 local-auth-only behavior for environments with no Account Again running.
ECOSYSTEM_MODE=false

# E8-D: Local AI Control Center (AI execution authority)
LOCAL_AI_CONTROL_CENTER_URL=http://localhost:9191/api

# ECOSYSTEM-H1: canonical local topology — PM Again :8000, QA Again :8002.
# These must never collide (both used to default to :8000). Override here
# only if your local setup genuinely differs from the canonical ports.
PM_AGAIN_URL=http://localhost:8000/api
QA_AGAIN_URL=http://localhost:8002/api
