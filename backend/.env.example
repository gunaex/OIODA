# Conductor Again — Environment Variables
# Copy to .env and fill in values

# Required
JWT_SECRET_KEY=change-me-to-a-random-32-char-string

# Deployment
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
COOKIE_SECURE=false

# Data
DATA_DIR=./data

# Bootstrap Admin
ADMIN_EMAIL=admin@conductoragain.local
ADMIN_PASSWORD=ChangeMe123!

# Cloudflare R2 (optional in dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=conductor-again-dev
R2_ENDPOINT=
R2_PRESIGN_TTL_SECONDS=300
R2_MAX_UPLOAD_BYTES=52428800

# Cloudflare Turnstile (optional in dev)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
