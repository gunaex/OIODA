{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://again.ecosystem/contracts/qa-validation-handoff.v1.json",
  "title": "QAValidationHandoff v1",
  "description": "Document Again -> verification authority: the exact design context QA Again must validate. Revision context is fixed at handoff time.",
  "type": "object",
  "required": ["contract", "baselineId", "projectId"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "qa-validation-handoff"},
        "version": {"type": "integer", "const": 1}
      }
    },
    "baselineId": {"type": "string"},
    "requirementIds": {"type": "array", "items": {"type": "string"}},
    "semanticObjectIds": {"type": "array", "items": {"type": "string"}},
    "designRevisionIds": {"type": "array", "items": {"type": "string"}},
    "targetRelease": {"type": ["string", "null"]},
    "projectId": {"type": "string"}
  }
}
