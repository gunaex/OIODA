# Copy to .env before running `npm run spike`.

# QA-Again backend origin (local dev: the FastAPI server, not the Vite proxy).
BACKEND_BASE_URL=http://127.0.0.1:8000

# Project slug the run belongs to (must already exist).
PROJECT_SLUG=checkout-flow-qa

# Runner token minted via: POST /api/runner-tokens (ADMIN only).
RUNNER_TOKEN=

# QA-Again frontend origin the runner drives — its own login page is the
# HYB-0 spike's target app (see docs/hybrid/HYB-0-GAP-ANALYSIS.md section 5).
TARGET_BASE_URL=http://localhost:5173

# Credentials the runner types into the login form. Any valid QA-Again
# user works — the spike doesn't need special runner-only credentials for
# the target app itself, only for the backend API (RUNNER_TOKEN above).
TARGET_EMAIL=admin@example.com
TARGET_PASSWORD=changeme456
