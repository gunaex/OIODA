# Account Again — environment template. Copy to .env (or export in your shell/process
# manager) — NEVER commit an actual .env file. This lists every env var the app reads.

# ── Database ──
# Local dev default: SQLite next to the app. E5 target for Zone B: Postgres-compatible
# managed DB (see docs/architecture/E5_DEPLOYMENT_TOPOLOGY.md) — not yet migrated.
ACCOUNT_AGAIN_DATABASE_URL=sqlite:///./account_again.db

# ── Secret resolver (E5) ──
# "env"        -> EnvSecretResolver (default, reads {PROVIDER}_API_KEY / CREDENTIAL_{ref})
# "static_map" -> StaticMapSecretResolver (structural stand-in for an external store —
#                 see docs/architecture/E5_SECRET_MANAGEMENT.md; has nothing seeded by
#                 default, for demonstration/testing only)
ACCOUNT_AGAIN_SECRET_RESOLVER=env

# ── Example provider credentials (dev mode only) ──
# Only needed if a CredentialReference is created for that provider AND something
# actually resolves it. Never real values in a committed file.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Service auth (RS256 JWT) ──
# Issuer and audience for the LOCAL_OIDC_COMPATIBLE_SERVICE_AUTH token issuer.
# Local dev default is account-again-local / again-ecosystem-services.
# Online deployment sets ACCOUNT_AGAIN_ISSUER to the canonical backend URL.
# ACCOUNT_AGAIN_ISSUER=account-again-local
# ACCOUNT_AGAIN_AUDIENCE=again-ecosystem-services

# ── Persistent signing key (online only) ──
# Base64-encoded PKCS8 PEM RSA private key. When unset, an ephemeral dev key is
# generated on every process start (tokens do not survive restart). When set, the
# key is loaded fail-closed and the derived kid is stable across restarts. Store
# this as a Fly secret — NEVER commit it, never put it in a frontend bundle, never
# log it.
# ACCOUNT_AGAIN_SIGNING_KEY_B64=
# Optional explicit key id. If unset, a fingerprint of the public key is used.
# ACCOUNT_AGAIN_SIGNING_KEY_ID=
