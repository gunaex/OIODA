{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://again-ecosystem/contracts/v1/PMStatus.json",
  "title": "PMStatus",
  "description": "Project and work package status from PM Again.",
  "type": "object",
  "version": "1.0.0",
  "required": ["pmStatusId", "correlationId", "workPackageId", "projectStatus", "reportedAt"],
  "properties": {
    "pmStatusId": { "type": "string", "examples": ["pms-001"] },
    "correlationId": { "type": "string", "examples": ["e2e-golden-001"] },
    "workPackageId": { "type": "string", "examples": ["wp-001"] },
    "projectId": { "type": "string" },
    "projectStatus": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "BLOCKED", "CANCELLED"] },
    "milestone": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "assignedTo": { "type": "string" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workPackageId": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "estimatedCompletion": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "source": { "type": "string" },
          "reference": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "reportedAt": { "type": "string", "format": "date-time" }
  }
}
