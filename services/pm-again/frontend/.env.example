# Copy to .env.local for local overrides — not usually needed, since the
# Vite dev server proxies /api to http://127.0.0.1:8000 automatically
# (see vite.config.js) when this is unset.
#
# For a production build (e.g. deploying to Vercel), set this to your
# deployed backend's base URL so the built frontend calls it directly:
# VITE_API_BASE_URL=https://your-backend.fly.dev
VITE_API_BASE_URL=
